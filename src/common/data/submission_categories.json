{
  "NONE": {},

  "GNM": {
    "required_tagset_id": "Genome-Assembly-Data",
    "required_st_comments": ["Sequencing Technology", "Genome Coverage", "Assembly Method"],
    "required_moltype": ["genomic DNA", "genomic RNA", "viral cRNA", "other DNA", "other RNA"],
    "invalid_moltype": ["mRNA"]
  },
  

  "WGS": {
    "inherits": ["GNM"],
    "required_datatype": "WGS",
