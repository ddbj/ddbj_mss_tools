    "required_st_comments": ["Sequencing Technology", "Coverage", "Assembly Method"],
    "invalid_moltype": ["genomic DNA", "other DNA"]
  },

  "TPA": {
    "required_datatype": "TPA",
    "required_keywords": [["TPA"], ["Third Party Data"], ["TPA:assembly"]]
  },

  "TPA-WGS": {
    "inherits": ["TPA", "WGS"],
    "required_datatype": "TPA-WGS"
  },

  "TPA-GNM": {
    "inherits": ["TPA", "GNM"]
  },

  "TPA-MAG-WGS": {
    "inherits": ["TPA", "MAG", "WGS"],
    "required_datatype": "TPA-WGS"
  }

