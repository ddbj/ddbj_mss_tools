      ["WGS"],
      ["STANDARD_DRAFT", "HIGH_QUALITY_DRAFT", "IMPROVED_HIGH_QUALITY_DRAFT",
       "ANNOTATION_GRADE", "NON_CONTIGUOUS_FINISHED"]
    ]
  },


  "ENV": {
    "required_division": "ENV",
    "required_keywords": [["ENV"]],
    "auto_source_qualifiers": {"environmental_sample": ""},
    "required_source_qualifiers": [
      "environmental_sample"
    ]

  },

  "MAG": {
    "inherits": ["ENV", "GNM"],
    "required_keywords": [["MAG"], ["Metagenome Assembled Genome"]],
    "required_source_qualifiers": [
      "metagenome_source",
      "isolation_source",
      "isolate"
    ],
    "source_identifier": "isolate",
    "required_dblinks": [
      "sequence read archive"
    ]
  },

  "MAG-WGS": {
    "inherits": ["MAG", "WGS"]
  },

  "TSA": {
    "required_division": "TSA",
    "required_keywords": [["TSA"], ["Transcriptome Shotgun Assembly"]],
